# Copy this file to .env for local development, and set the same
# two values in Netlify (Site settings -> Environment variables) for production.
#
# Both of these come from Supabase: Project Settings -> API.
# The anon key is SAFE to expose in frontend code — it is designed for
# this and is restricted by the Row Level Security policies in supabase/schema.sql.
# NEVER put the "service_role" key anywhere in this project.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
